# ════════════════════════════════════════════════════════════════════════════
#  ClassKit API — environment. Copy to .env on the server and fill in the blanks.
#  Values marked REQUIRED must be set or the server refuses to start.
# ════════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3030
# Public HTTPS URL of this API (no trailing slash).
BASE_URL=https://classkit-api.example.com
# Public URL of the UI (Vercel). Used to build the kiosk + public schedule links shown in Settings.
UI_BASE_URL=https://classkit.example.com
LOG_LEVEL=info

# ── Database (REQUIRED) ─────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/classkit

# ── HighLevel marketplace app (REQUIRED) — Marketplace → your app → Advanced Settings / Auth ──
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Must exactly match the Redirect URL in the app settings.
GHL_REDIRECT_URI=https://classkit-api.example.com/oauth/callback
# "Shared Secret" (SSO key) — decrypts the user context for the custom page.
GHL_SSO_KEY=
# App ID (from the app's URL / dashboard). Not used yet; needed when billing is added.
GHL_APP_ID=

# HighLevel endpoints — leave as-is unless HighLevel changes them.
GHL_API_URL=https://services.leadconnectorhq.com
GHL_OAUTH_URL=https://services.leadconnectorhq.com/oauth
GHL_MARKETPLACE_URL=https://marketplace.gohighlevel.com
GHL_BOOKING_WIDGET_URL=https://api.leadconnectorhq.com/widget/booking

# ── Webhook signature verification ──────────────────────────────────────────
# Ed25519 public key from HighLevel's webhook docs (PEM; use \n for newlines on one line).
GHL_WEBHOOK_ED25519_PUBLIC_KEY=
# Start with false (log-only). Once logs show real webhooks verifying, switch to true.
WEBHOOK_VERIFY_ENFORCE=false

# ── Session (REQUIRED) ──────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET=
SESSION_TTL=12h

# ── CORS ────────────────────────────────────────────────────────────────────
# Already allowed: *.gohighlevel.com, *.leadconnectorhq.com, *.vercel.app, *.vaultsuite.store, localhost.
# Add the UI's custom domain here if it's anything else (comma-separated hostnames).
CORS_EXTRA_HOSTS=

# ── Background jobs (credit expiry, reminders, auto no-show) ────────────────
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=300000

# ── Public kiosk / schedule abuse guard ─────────────────────────────────────
PUBLIC_RATE_LIMIT_PER_MIN=20

# ── Debugging ───────────────────────────────────────────────────────────────
# Log each webhook's raw payload (first 4 KB). Turn on for the first live tests, then off.
LOG_WEBHOOK_PAYLOADS=false

# ── Local development only — MUST be false on a server (startup fails otherwise) ──
GHL_MOCK=false
ALLOW_DEV_LOGIN=false
