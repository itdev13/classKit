# ── Server ──────────────────────────────────────────────────────────────────
PORT=3030
NODE_ENV=development
BASE_URL=http://localhost:3030
# Where the UI is hosted (used to build kiosk / public schedule links shown to admins).
UI_BASE_URL=http://localhost:5175
LOG_LEVEL=info

# ── Database (required) ─────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/classkit

# ── GoHighLevel OAuth (marketplace app settings) ────────────────────────────
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:3030/oauth/callback
GHL_API_URL=https://services.leadconnectorhq.com
GHL_OAUTH_URL=https://services.leadconnectorhq.com/oauth
# Shared Secret used to decrypt the Custom Page SSO user-context blob.
GHL_SSO_KEY=
GHL_APP_ID=

# ── Local development ───────────────────────────────────────────────────────
# GHL_MOCK=true stubs every GHL API call (calendars, contacts, SMS, appointments) so the whole app
# runs locally with no marketplace install. NEVER enable in production.
GHL_MOCK=false
# Accept a raw ?locationId with no SSO proof. Dev only — NEVER enable in production.
ALLOW_DEV_LOGIN=false

# ── Webhook signature verification (see helmdesk rollout notes) ─────────────
GHL_WEBHOOK_ED25519_PUBLIC_KEY=
WEBHOOK_VERIFY_ENFORCE=false

# ── Session ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL=12h

# ── Background jobs (expiry, reminders, auto no-show) ───────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=300000
